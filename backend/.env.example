# NOVA Mission Command API configuration
# Copy this file to .env and adjust values for the local environment.

APP_NAME=NOVA Mission Command API
APP_VERSION=1.0.0
APP_DESCRIPTION=Backend API for mission management, persistence, configuration, and simulation orchestration.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Reuses the project SQLite database created by the installer.
# Tests override this value with an isolated temporary database.
DATABASE_URL=sqlite:///../database/nova.db

# Comma-separated CORS origins. Do not use wildcard credentials in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Force the explicit mock adapter. Leave false to use the live simulation engine.
SIMULATION_FORCE_MOCK=false
